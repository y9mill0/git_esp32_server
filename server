#include <WiFi.h>
#include <WebServer.h>

// --- НАСТРОЙКИ ТОЧКИ ДОСТУПА (AP) ---
const char* ap_ssid = "ESP32_Server";  // Название Wi-Fi сети, которую создаст ESP32
const char* ap_password = "12345678";  // Пароль (ОБЯЗАТЕЛЬНО минимум 8 символов!)

// Создаем сервер на порту 80
WebServer server(80);

// --- ПИНЫ И ПЕРЕМЕННЫЕ ---
const int LED_PIN = 2;  // Встроенный светодиод
bool ledState = false;
unsigned long requestCount = 0;
unsigned long startTime = 0;

// --- ФУНКЦИЯ ГЕНЕРАЦИИ HTML ---
