// --- ОБРАБОТЧИКИ ---
void handleRoot() {
  requestCount++;
  server.send(200, "text/html; charset=utf-8", getHTMLPage());
}

void handleApiToggle() {
  requestCount++;
  ledState = !ledState;
  digitalWrite(LED_PIN, ledState ? HIGH : LOW);
  String json = "{\"success\":true,\"led\":" + String(ledState ? "true" : "false") + "}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  requestCount++;
  server.send(404, "text/plain; charset=utf-8", "404: Страница не найдена");
}

// --- SETUP ---
void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Serial.println("\n=== ESP32 Автономный Сервер ===");
  Serial.println("Создание Wi-Fi сети...");

  // Создаем точку доступа (AP)
  WiFi.softAP(ap_ssid, ap_password);

  startTime = millis();

  IPAddress myIP = WiFi.softAPIP();
  Serial.println("✅ Сеть создана!");
  Serial.print("📶 Подключитесь к Wi-Fi: ");
  Serial.println(ap_ssid);
  Serial.print("🔑 Пароль: ");
  Serial.println(ap_password);
  Serial.print("🌐 Откройте в браузере: http://");
  Serial.println(myIP);

  // Маршруты
  server.on("/", handleRoot);
  server.on("/api/toggle", HTTP_POST, handleApiToggle);
  server.onNotFound(handleNotFound);

  server.begin();
  Serial.println("🚀 Сервер запущен и ждет подключений!");
}

// --- LOOP ---
void loop() {
  server.handleClient();
}