#include <WiFi.h>
#include <WebServer.h>

// --- НАСТРОЙКИ ТОЧКИ ДОСТУПА ---
const char* ap_ssid = "ESP32_Terminal";
const char* ap_password = "12345678";

WebServer server(80);

unsigned long requestCount = 0;
unsigned long startTime = 0;

// --- ГЕНЕРАЦИЯ HTML ---
String getHTMLPage() {
  IPAddress ip = WiFi.softAPIP();
  unsigned long uptime = (millis() - startTime) / 1000;
  unsigned long hours = uptime / 3600;
  unsigned long minutes = (uptime % 3600) / 60;
  unsigned long seconds = uptime % 60;

  float tempC = temperatureRead();
  String tempStr = String(tempC, 1) + " °C";

  String html = R"HTML(
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ESP32 TERMINAL</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'VT323', monospace;
      background: #0a0a0a;
      color: #f0f0f0;
      min-height: 100vh;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      text-shadow: 0 0 5px #ffffff;
      position: relative;
      overflow-x: hidden;
    }

    /* Эффект сканлайнов (CRT-монитор) */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.25),
        rgba(0, 0, 0, 0.25) 1px,
        transparent 1px,
        transparent 3px
      );
      pointer-events: none;
      z-index: 10;
    }

    /* Виньетка по краям */
    body::after {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: radial-gradient(circle, transparent 60%, rgba(0,0,0,0.75) 100%);
      pointer-events: none;
      z-index: 11;
    }

    .container {
      max-width: 700px;
      width: 100%;
      background: #000000;
      border: 2px solid #f0f0f0;
      padding: 25px;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.4), inset 0 0 20px rgba(255, 255, 255, 0.05);
      position: relative;
      z-index: 5;
    }

    .header {
      border-bottom: 1px dashed #f0f0f0;
      padding-bottom: 10px;
      margin-bottom: 20px;
      font-size: 22px;
    }

    .header-line {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 5px;
    }

    .cursor::after {
      content: "_";
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 50% { opacity: 1; }
      50.1%, 100% { opacity: 0; }
    }

    .box {
      border: 1px solid #f0f0f0;
      padding: 15px;
      margin-bottom: 20px;
    }

    .box-title {
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 12px;
      border-bottom: 1px solid #f0f0f0;
      padding-bottom: 5px;
    }

    .row {
      display: flex;
      justify-content: space-between;
      font-size: 18px;
      padding: 4px 0;
      border-bottom: 1px dotted #333333;
    }

    .row:last-child { border-bottom: none; }

    .label { color: #888888; }
    .value { color: #f0f0f0; }

    .temp-big {
      font-size: 52px;
      text-align: center;
      padding: 15px 0;
      letter-spacing: 4px;
      animation: flicker 4s infinite;
    }

    @keyframes flicker {
      0%, 19.999%, 22%, 62.999%, 64%, 64.999%, 70%, 100% { opacity: 1; }
      20%, 21.999%, 63%, 63.999%, 65%, 69.999% { opacity: 0.7; }
    }

    .footer {
      margin-top: 20px;
      font-size: 14px;
      color: #888888;
      text-align: center;
      border-top: 1px dashed #f0f0f0;
      padding-top: 10px;
    }

    .glow {
      text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header glow">
      <div class="header-line">
        <span>ESP32@TERMINAL:~#</span>
        <span class="cursor">ONLINE</span>
      </div>
    </div>

    <div class="box">
      <div class="box-title">[ SYSTEM INFO ]</div>
      <div class="row"><span class="label">IP ADDRESS ....</span><span class="value">)HTML" + ip.toString() + R"HTML(</span></div>
      <div class="row"><span class="label">UPTIME ........</span><span class="value">)HTML" + String(hours) + "h " + String(minutes) + "m " + String(seconds) + "s" + R"HTML(</span></div>
      <div class="row"><span class="label">REQUESTS ......</span><span class="value">)HTML" + String(requestCount) + R"HTML(</span></div>
      <div class="row"><span class="label">SSID ..........</span><span class="value">)HTML" + String(ap_ssid) + R"HTML(</span></div>
    </div>

    <div class="box">
      <div class="box-title">[ INTERNAL TEMPERATURE ]</div>
      <div class="temp-big glow">)HTML" + tempStr + R"HTML(</div>
    </div>

    <div class="footer">
      SYS_READY · ESP32 CORE TEMP SENSOR · REFRESH: AUTO (5s)
    </div>
  </div>

  <script>
    setTimeout(() => location.reload(), 5000);
  </script>
</body>
</html>
)HTML";
  return html;
}

// --- ОБРАБОТЧИКИ ---
void handleRoot() {
  requestCount++;
  server.send(200, "text/html; charset=utf-8", getHTMLPage());
}

void handleNotFound() {
  requestCount++;
  server.send(404, "text/plain; charset=utf-8", "ERR 404: PAGE NOT FOUND");
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n=== ESP32 TERMINAL SERVER ===");
  Serial.println("Инициализация...");

  WiFi.softAP(ap_ssid, ap_password);
  startTime = millis();

  IPAddress myIP = WiFi.softAPIP();
  Serial.println("✅ Сеть создана!");
  Serial.print("📶 SSID: "); Serial.println(ap_ssid);
  Serial.print("🔑 PASS: "); Serial.println(ap_password);
  Serial.print("🌐 IP:   http://"); Serial.println(myIP);

  server.on("/", handleRoot);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("🚀 Терминал онлайн!");
}

void loop() {
  server.handleClient();
}